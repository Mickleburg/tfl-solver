digraph nfa {
  rankdir=LR;
  __start [shape=none,label=""];
  q0 [shape=doublecircle,label="0"];
  q1 [shape=circle,label="1"];
  q2 [shape=circle,label="2"];
  q3 [shape=doublecircle,label="3"];
  q4 [shape=circle,label="4"];
  q5 [shape=circle,label="5"];
  __start -> q0;
  q0 -> q0 [label="b"];
  q0 -> q4 [label="a"];
  q0 -> q5 [label="a,b"];
  q1 -> q2 [label="b"];
  q2 -> q3 [label="b"];
  q3 -> q4 [label="a"];
  q3 -> q5 [label="a,b"];
  q4 -> q3 [label="a"];
