{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case_id": {"type": "string"},
    "mode": {"type": "string", "enum": ["training", "full"]},
    "task_class": {
      "type": "string",
      "enum": [
        "LAB-1", "LAB-2", "LAB-3", "LAB-4", "LAB-5",
        "RK1-A", "RK1-B", "RK1-C", "RK2-A", "RK2-B", "RK2-C",
        "EXAM-1", "EXAM-2", "EXAM-3", "EXAM-ERROR", "MAT", "CODE", "PHARMA"
      ]
    },
    "seminar_analog": {"type": "string"},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {"type": "string"},
          "evidence": {"type": "string"}
        },
        "required": ["text", "evidence"],
        "additionalProperties": false
      }
    },
    "micro_methods": {"type": "array", "items": {"type": "string"}},
    "prerequisites_used": {"type": "array", "items": {"type": "string"}},
    "chosen_method": {"type": "string"},
    "oracle_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {"type": "string"},
          "operation": {"type": "string"},
          "input": {"type": "string"},
          "result": {"type": "string"}
        },
        "required": ["module", "operation", "input", "result"],
        "additionalProperties": false
      }
    },
    "final_answer": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "required": [
    "case_id", "mode", "task_class", "seminar_analog", "observations",
    "micro_methods", "prerequisites_used", "chosen_method", "oracle_calls",
    "final_answer", "limitations"
  ],
  "additionalProperties": false
}
